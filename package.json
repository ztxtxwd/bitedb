{
  "name": "bitedb",
  "version": "0.1.0",
  "description": "A headless, zero-provisioning serverless NoSQL database engine built on Feishu/Lark Bitable",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztxtxwd/bitedb.git"
  },
  "homepage": "https://github.com/ztxtxwd/bitedb#readme",
  "bugs": {
    "url": "https://github.com/ztxtxwd/bitedb/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "test": "tsx --test test/*.test.ts",
    "bench": "tsx bench/perf.ts",
    "bench:mock": "tsx bench/perf.ts --mock --docs 300 --read-ops 15 --sequential 5",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "feishu",
    "lark",
    "bitable",
    "多维表格",
    "database",
    "nosql",
    "serverless",
    "sdk"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
